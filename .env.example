# Серверные переменные окружения
PORT=3001

# Пароль для входа в панель владельца (по умолчанию: admin2026)
ADMIN_PASSWORD=admin2026
SESSION_SECRET=sgx-super-secret-session-key-2026

# Настройки AI-ассистента (OpenAI-совместимый API: Clodex / OpenRouter / OpenAI)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.clodex.ai/v1
AI_MODEL=claude-3-5-sonnet-latest

# URL базы данных PostgreSQL (если используется Prisma в production)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sgx_detailing?schema=public"
